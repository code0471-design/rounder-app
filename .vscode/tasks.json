{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ROUNDER: Preview (8888, keep-alive)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/keep_alive_preview.ps1",
        "-SkipPanelOpen"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "flutter",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting web-server",
          "endsPattern": "lib/main.dart is being served at"
        }
      }
    },
    {
      "label": "ROUNDER: Flutter run (Chrome)",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\cursor-flutter\\flutter\\bin\\flutter.bat",
      "args": ["run", "-d", "chrome", "--web-port=8888", "--web-hostname=127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:LOCALAPPDATA}\\cursor-flutter\\flutter\\bin;${env:PATH}"
        }
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
