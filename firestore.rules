rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 하루 전 알림 대기열은 문서 하나씩만. 목록 조회는 막는다.
    // 예전 앱이 대기열 전체를 읽어 알림톡을 여러 번 예약하지 못하게 한다.
    // request.path.matches() 는 Path에 없어서 규칙이 실패하고 전 컬렉션이 막힌다.
    // 대기열만 따로 두고, 나머지 읽기/쓰기는 col != 'd1_queue' 로 연다.
    match /d1_queue/{docId} {
      allow get, create, update, delete: if signedIn();
      allow list: if false;
    }

    match /{col}/{document=**} {
      allow read, write: if signedIn() && col != 'd1_queue';
    }
  }
}
